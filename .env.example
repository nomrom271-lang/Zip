# freemodel.in API key (https://freemodel.in/register). Browser Settings me bhi daal sakte ho.
FREEMODEL_API_KEY=
FREEMODEL_BASE=https://freemodel.in/v1
PORT=3000
# Optional: poore app par password
APP_PASSWORD=
# Optional: 1 = user apna base URL badal na sake
LOCK_BASE=0
# Optional: Chrome ka path (PDF ke liye), auto-detect hota hai
CHROME_PATH=
